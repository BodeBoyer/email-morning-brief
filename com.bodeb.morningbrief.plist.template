<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.bodeb.morningbrief</string>

  <key>ProgramArguments</key>
  <array>
    <string>/Users/bodeb/email-morning-brief/venv/bin/python</string>
    <string>/Users/bodeb/email-morning-brief/main.py</string>
  </array>

  <!-- Run at 7:30 AM and 6:00 PM if the laptop is open at those times -->
  <key>StartCalendarInterval</key>
  <array>
    <dict>
      <key>Hour</key>
      <integer>7</integer>
      <key>Minute</key>
      <integer>30</integer>
    </dict>
    <dict>
      <key>Hour</key>
      <integer>18</integer>
      <key>Minute</key>
      <integer>0</integer>
    </dict>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/bodeb/email-morning-brief</string>

  <!-- Pass environment variables to the script -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>ANTHROPIC_API_KEY</key>
    <string>REPLACE_WITH_YOUR_ANTHROPIC_API_KEY</string>
    <key>PATH</key>
    <string>/usr/local/bin:/usr/bin:/bin:/Users/bodeb/email-morning-brief/venv/bin</string>
  </dict>

  <key>StandardOutPath</key>
  <string>/Users/bodeb/email-morning-brief/logs/morning-brief.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/bodeb/email-morning-brief/logs/morning-brief-error.log</string>
</dict>
</plist>
